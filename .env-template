# Copied to ~/.cyrus/.env by setup.sh, with the {{...}} placeholders below
# filled in from your answers. Never commit the filled-in version — it holds
# API keys and tokens.

# --- Claude Code auth (required) ---
# An OAuth token or API key Cyrus uses to run Claude Code sessions on your
# behalf. See the cyrus-setup-claude-auth skill/docs for how to mint one.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Linear (required) ---
# Client ID/secret come from the Linear OAuth application you create during
# setup (Linear -> Settings -> API -> OAuth Applications). Webhook secret
# comes from the webhook you attach to that same OAuth application, pointed
# at ${CYRUS_BASE_URL}/linear-webhook.
LINEAR_DIRECT_WEBHOOKS=true
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# --- Networking (required) ---
# CYRUS_BASE_URL must be reachable from the internet (Linear delivers
# webhooks here) — a Tailscale Funnel URL is the easiest way to get that
# from a machine that isn't otherwise internet-facing.
CYRUS_BASE_URL=https://{{TAILSCALE_HOSTNAME}}:{{FUNNEL_PORT}}
CYRUS_SERVER_PORT={{CYRUS_SERVER_PORT}}

# --- GitHub App (optional) ---
# Basic PR creation already works via `gh` (installed + `gh auth login`,
# checked as a prerequisite). A GitHub App only adds a dedicated bot
# identity and auto-rebase/merge. See the cyrus-setup-github skill. Also
# requires a private key file saved at {{CYRUS_HOME}}/github-app.pem
# (downloaded when you create the GitHub App).
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=

# --- GitHub webhook (further optional) ---
# Only relevant if you've set up the GitHub App above — needed for @mention
# replies on PR comments (requires CYRUS_HOST_EXTERNAL=true and a webhook on
# the GitHub App pointed at ${CYRUS_BASE_URL}/github-webhook).
# GITHUB_WEBHOOK_SECRET=

# --- Logging (safe defaults while setting up) ---
CYRUS_WEBHOOK_DEBUG=true
CYRUS_LOG_LEVEL=DEBUG
