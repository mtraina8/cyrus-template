#!/usr/bin/env bash
# Shared machine-specific values for the ops scripts (cyrus-start.sh,
# cyrus-health-check.sh, cyrus-reset.sh, cyrus-activity.sh). Sourced by them
# — not meant to be run directly, and holds no secrets (those live in .env).
#
# Generated by setup.sh, or filled in by hand per the README's Manual setup
# steps. Safe to hand-edit afterward; re-running setup.sh regenerates it from
# your answers.
# Absolute path to this Cyrus install
CYRUS_HOME="{{CYRUS_HOME}}"
# pm2 process name used by all ops scripts
PM2_NAME="cyrus"
# Local Cyrus server port (CYRUS_SERVER_PORT in .env)
LOCAL_PORT={{CYRUS_SERVER_PORT}}
# Tailscale Funnel HTTPS port
FUNNEL_PORT={{FUNNEL_PORT}}
# Public endpoint — must match CYRUS_BASE_URL in .env
FUNNEL_URL="https://{{TAILSCALE_HOSTNAME}}:{{FUNNEL_PORT}}"
# Absolute path to `cyrus`, used if PATH lookup fails under pm2
CYRUS_BIN_FALLBACK="{{CYRUS_BIN_PATH}}"
